NODE_ENV=production
PORT=3000

# Application
CORS_ALLOWED_ORIGINS=https://smartbiz.example.com
REQUEST_SIZE_LIMIT=1mb
SLOW_QUERY_THRESHOLD_MS=500

# Database
DATABASE_URL=postgresql://vyaparam:change_me@postgres:5432/vyaparam_db?schema=public
POSTGRES_DB=vyaparam_db
POSTGRES_USER=vyaparam
POSTGRES_PASSWORD=change_me

# Cache
REDIS_URL=redis://redis:6379

# Security
JWT_ACCESS_SECRET=replace_with_long_random_access_secret
JWT_REFRESH_SECRET=replace_with_long_random_refresh_secret

# Deploy Images
BACKEND_IMAGE=ghcr.io/smartbiz/backend:latest
FRONTEND_IMAGE=ghcr.io/smartbiz/frontend:latest
