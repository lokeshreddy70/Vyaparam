  deliveries    NotificationDelivery[]
  audits        NotificationAuditLog[]

  @@index([businessId, status, priority, scheduledAt, nextRetryAt])
  @@index([businessId, channel, eventType, createdAt])
  @@index([businessId, userId, deletedAt])
  @@map("notification_queue")
}

