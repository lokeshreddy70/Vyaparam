generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  OWNER
  MANAGER
  CASHIER
  KITCHEN_STAFF
  WAITER
}

enum BusinessType {
  RESTAURANT
  CAFE
  BAKERY
  GROCERY
  SUPERMARKET
  MEDICAL
  PHARMACY
  CEMENT
  HARDWARE
  PAINT
  ELECTRICAL
  PESTICIDE
  AGRICULTURE
  WHOLESALE
  RETAIL
}

enum OrderType {
  DINE_IN
  TAKEAWAY
  DELIVERY
}

enum KotStatus {
  QUEUED
  READY
  CANCELLED
}

enum OrderStatus {
  PENDING
  SENT_TO_KITCHEN
  READY
  BILLED
  CANCELLED
}

enum InvoiceStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  REFUNDED
}

enum PaymentMethod {
  CASH
  CARD
  UPI
  BANK_TRANSFER
  WALLET
  NET_BANKING
  GIFT_CARD
  STORE_CREDIT
  MIXED
}

enum BillingDocumentType {
  SALES_INVOICE
  PURCHASE_INVOICE
  QUOTATION
  ESTIMATE
  SALES_ORDER
  PURCHASE_ORDER
  DELIVERY_CHALLAN
  GOODS_RECEIPT_NOTE
  SALES_RETURN
  PURCHASE_RETURN
  CREDIT_NOTE
  DEBIT_NOTE
  EXPENSE_ENTRY
  INCOME_ENTRY
  POS_BILL
}

enum BillingDocumentStatus {
  DRAFT
  HOLD
  CONFIRMED
  COMPLETED
  CANCELLED
  VOID
}

enum ShiftStatus {
  OPEN
  CLOSED
}

enum TableStatus {
  AVAILABLE
  OCCUPIED
  CLEANING
}

enum MovementType {
  IN
  OUT
  ADJUSTMENT
  TRANSFER_IN
  TRANSFER_OUT
}

enum PurchaseOrderStatus {
  DRAFT
  OPEN
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum SalesOrderStatus {
  DRAFT
  CONFIRMED
  PARTIALLY_FULFILLED
  FULFILLED
  CANCELLED
}

enum TransferStatus {
  DRAFT
  IN_TRANSIT
  COMPLETED
  CANCELLED
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

enum NotificationType {
  INFO
  WARNING
  ERROR
  SUCCESS
}

enum NotificationChannel {
  IN_APP
  PUSH
  EMAIL
  SMS
  WHATSAPP
}

enum NotificationPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum NotificationDeliveryStatus {
  QUEUED
  PROCESSING
  SENT
  FAILED
  RETRY
  CANCELLED
}

enum NotificationEventType {
  ANNOUNCEMENT
  BROADCAST
  REMINDER
  TASK
  ATTENDANCE
  PAYROLL
  INVENTORY
  LOW_STOCK
  OUT_OF_STOCK
  SALES
  PURCHASE
  SUBSCRIPTION
  INVOICE
  SYSTEM
  SECURITY
  FAILED_LOGIN
  PASSWORD_RESET
  EMAIL_VERIFICATION
}

enum OtpPurpose {
  PASSWORD_RESET
  EMAIL_VERIFICATION
  LOGIN_2FA
}

enum FileCategory {
  COMPANY_LOGO
  PRODUCT_IMAGE
  EMPLOYEE_PHOTO
  CUSTOMER_DOCUMENT
  SUPPLIER_DOCUMENT
  INVOICE_PDF
  QUOTATION_PDF
  PURCHASE_PDF
  RECEIPT_PDF
  BARCODE
  QR_CODE
  ATTACHMENT
  OTHER
}

enum StorageProvider {
  LOCAL
  S3
  R2
  AZURE_BLOB
  GCS
}

enum FileStatus {
  ACTIVE
  ARCHIVED
  DELETED
}

enum FileVisibility {
  PRIVATE
  BUSINESS
  PUBLIC
}

enum BackgroundJobType {
  CLEANUP
  BACKUP
  NOTIFICATION
  AUDIT_ROLLUP
  CUSTOM
}

enum BackgroundJobStatus {
  QUEUED
  RUNNING
  SUCCESS
  FAILED
  RETRY
  CANCELLED
}

enum BackgroundJobPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum BusinessConfigAssetType {
  LOGO
  DOCUMENT
  IMAGE
  INVOICE_TEMPLATE
  RECEIPT_TEMPLATE
}

enum LedgerEntryType {
  DEBIT
  CREDIT
  ADJUSTMENT
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERN
  TEMPORARY
}

enum EmployeeLifecycleStatus {
  ACTIVE
  RESIGNED
  TERMINATED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  ON_LEAVE
}

enum LeaveRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum PayrollRunStatus {
  DRAFT
  PROCESSED
  PAID
}

enum HrNotificationType {
  SHIFT_REMINDER
  ATTENDANCE_REMINDER
  LEAVE_NOTIFICATION
  PAYROLL_NOTIFICATION
}

enum HrDocumentType {
  PHOTO
  IDENTITY
  CONTRACT
  OTHER
}

model Business {
  id          String   @id @default(uuid())
  name        String
  type        BusinessType
  address     String?
  phone       String?
  gstNumber   String?
  createdBy   String?
  updatedBy   String?
  deletedBy   String?
  deletedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  branches          Branch[]
  users             User[]
  employees         Employee[]
  roles             RoleEntity[]
  permissions       Permission[]
  rolePermissions   RolePermission[]
  customerGroups    CustomerGroup[]
  customerTypes     CustomerType[]
  customers         Customer[]
  customerContacts  CustomerContact[]
  customerAddresses CustomerAddress[]
  customerLedgers   CustomerLedger[]
  supplierGroups    SupplierGroup[]
  supplierTypes     SupplierType[]
  suppliers         Supplier[]
  supplierContacts  SupplierContact[]
  supplierAddresses SupplierAddress[]
  supplierLedgers   SupplierLedger[]
  categories        Category[]
  subCategories     SubCategory[]
  brands            Brand[]
  units             Unit[]
  products          Product[]
  productVariants   ProductVariant[]
  warehouses        Warehouse[]
  inventories       Inventory[]
  inventoryMovements InventoryMovement[]
  purchaseOrders    PurchaseOrder[]
  purchaseItems     PurchaseItem[]
  salesOrders       SalesOrder[]
  salesItems        SalesItem[]
  bills             Bill[]
  billItems         BillItem[]
  invoices          Invoice[]
  billingDocuments  BillingDocument[]
  billingDocumentItems BillingDocumentItem[]
  payments          Payment[]
  cashRegisters     CashRegister[]
  cashShifts        CashShift[]
  posTerminals      PosTerminal[]
  expenses          Expense[]
  expenseCategories ExpenseCategory[]
  taxes             Tax[]
  discounts         Discount[]
  coupons           Coupon[]
  priceLists        PriceList[]
  stockAdjustments  StockAdjustment[]
  transfers         Transfer[]
  tables            RestaurantTable[]
  kitchenOrders     KitchenOrder[]
  orders            Order[]
  notifications     Notification[]
  notificationTemplates    NotificationTemplate[]
  notificationPreferences  NotificationPreference[]
  notificationQueueItems   NotificationQueue[]
  notificationDeliveries   NotificationDelivery[]
  notificationAuditLogs    NotificationAuditLog[]
  announcements            Announcement[]
  reminders                Reminder[]
  otpRequests              OtpRequest[]
  fileObjects              FileObject[]
  fileVersions             FileVersion[]
  fileAttachments          FileAttachment[]
  fileSignedUrls           FileSignedUrl[]
  fileAuditLogs            FileAuditLog[]
  apiRequestLogs           ApiRequestLog[]
  apiErrorLogs             ApiErrorLog[]
  backgroundJobs           BackgroundJob[]
  backgroundJobRuns        BackgroundJobRun[]
  settings          Setting[]
  businessConfiguration BusinessConfiguration?
  businessConfigAssets  BusinessConfigAsset[]
  subscriptionPlans SubscriptionPlan[]
  subscriptions     Subscription[]
  featureFlags      FeatureFlag[]
  refreshTokens     RefreshToken[]
  sessions          Session[]
  auditLogs         AuditLog[]
  activityLogs      ActivityLog[]
  errorLogs         ErrorLog[]
  departments             Department[]
  designations            Designation[]
  employeeEmergencyContacts EmployeeEmergencyContact[]
  employeeDocuments       EmployeeDocument[]
  attendanceShifts        AttendanceShift[]
  attendanceRecords       AttendanceRecord[]
  attendanceBreaks        AttendanceBreak[]
  attendanceCorrections   AttendanceCorrection[]
  leaveTypes              LeaveType[]
  leaveBalances           LeaveBalance[]
  leaveRequests           LeaveRequest[]
  holidayCalendars        HolidayCalendar[]
  weeklyOffConfigurations WeeklyOffConfiguration[]
  salaryComponents        SalaryComponent[]
  employeeSalaryComponents EmployeeSalaryComponent[]
  payrollRuns             PayrollRun[]
  payrollItems            PayrollItem[]
  roleTemplates           RoleTemplate[]
  customRoles             CustomRole[]
  customRolePermissions   CustomRolePermission[]
  employeeRoleAssignments EmployeeRoleAssignment[]
  employeeKpis            EmployeeKpi[]
  hrNotifications         HrNotification[]

  @@index([deletedAt])
  @@map("businesses")
}

model Branch {
  id        String   @id @default(uuid())
  businessId String
  name      String
  address   String?
  phone     String?
  createdBy String?
  updatedBy String?
  deletedBy String?
  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business           Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  users              User[]
  employees          Employee[]
  customers          Customer[]
  customerLedgers    CustomerLedger[]
  suppliers          Supplier[]
  supplierLedgers    SupplierLedger[]
  products           Product[]
  productVariants    ProductVariant[]
  warehouses         Warehouse[]
  inventories        Inventory[]
  inventoryMovements InventoryMovement[]
  purchaseOrders     PurchaseOrder[]
  salesOrders        SalesOrder[]
  bills              Bill[]
  invoices           Invoice[]
  billingDocuments   BillingDocument[]
  cashRegisters      CashRegister[]
  cashShifts         CashShift[]
  posTerminals       PosTerminal[]
  payments           Payment[]
  expenses           Expense[]
  priceLists         PriceList[]
  stockAdjustments   StockAdjustment[]
  transfersFrom      Transfer[] @relation("TransferFromBranch")
  transfersTo        Transfer[] @relation("TransferToBranch")
  tables             RestaurantTable[]
  orders             Order[]
  kitchenOrders      KitchenOrder[]
  notifications      Notification[]
  notificationPreferences  NotificationPreference[]
  notificationQueueItems   NotificationQueue[]
  announcements            Announcement[]
  reminders                Reminder[]
  fileObjects              FileObject[]
  fileAttachments          FileAttachment[]
  apiRequestLogs           ApiRequestLog[]
  apiErrorLogs             ApiErrorLog[]
  backgroundJobs           BackgroundJob[]
  settings           Setting[]
  refreshTokens      RefreshToken[]
  sessions           Session[]
  auditLogs          AuditLog[]
  activityLogs       ActivityLog[]
  errorLogs          ErrorLog[]
  departments             Department[]
  designations            Designation[]
  attendanceShifts        AttendanceShift[]
  attendanceRecords       AttendanceRecord[]
  attendanceBreaks        AttendanceBreak[]
  attendanceCorrections   AttendanceCorrection[]
  leaveBalances           LeaveBalance[]
  leaveRequests           LeaveRequest[]
  holidayCalendars        HolidayCalendar[]
  weeklyOffConfigurations WeeklyOffConfiguration[]
  employeeSalaryComponents EmployeeSalaryComponent[]
  payrollRuns             PayrollRun[]
  payrollItems            PayrollItem[]
  employeeRoleAssignments EmployeeRoleAssignment[]
  employeeKpis            EmployeeKpi[]
  hrNotifications         HrNotification[]

  @@unique([businessId, name])
  @@index([businessId, deletedAt])
  @@map("branches")
}

model User {
  id               String   @id @default(uuid())
  businessId       String
  branchId         String?
  name             String
  email            String   @unique
  passwordHash     String
  role             Role     @default(OWNER)
  isActive         Boolean  @default(true)
  failedLoginAttempts Int   @default(0)
  lockedUntil      DateTime?
  refreshTokenHash String?
  createdBy        String?
  updatedBy        String?
  deletedBy        String?
  deletedAt        DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  business         Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch           Branch?   @relation(fields: [branchId], references: [id], onDelete: SetNull)
  employee         Employee?
  customerInvoices Invoice[] @relation("InvoiceCustomer")
  cashierInvoices  Invoice[] @relation("InvoiceCashier")
  refreshTokens    RefreshToken[]
  sessions         Session[]
  auditLogs        AuditLog[]
  activityLogs     ActivityLog[]
  errorLogs        ErrorLog[]
  apiRequestLogs   ApiRequestLog[]
  apiErrorLogs     ApiErrorLog[]

  @@index([businessId, branchId, deletedAt])
  @@map("users")
}

model Employee {
  id         String   @id @default(uuid())
  businessId String
  branchId   String?
  userId     String   @unique
  employeeNo String
  designation String?
  departmentId String?
  designationId String?
  managerEmployeeId String?
  employmentType EmploymentType?
  salaryBase Float? @default(0)
  joiningDate DateTime?
  resignationDate DateTime?
  terminationDate DateTime?
  lifecycleStatus EmployeeLifecycleStatus @default(ACTIVE)
  createdBy  String?
  updatedBy  String?
  deletedBy  String?
  deletedAt  DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch   Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  designationRef Designation? @relation(fields: [designationId], references: [id], onDelete: SetNull)
  manager Employee? @relation("EmployeeManager", fields: [managerEmployeeId], references: [id], onDelete: SetNull)
  subordinates Employee[] @relation("EmployeeManager")
  emergencyContacts EmployeeEmergencyContact[]
  documents EmployeeDocument[]
  attendanceRecords AttendanceRecord[]
  attendanceBreaks AttendanceBreak[]
  attendanceCorrections AttendanceCorrection[]
  leaveBalances LeaveBalance[]
  leaveRequests LeaveRequest[]
  employeeSalaryComponents EmployeeSalaryComponent[]
  payrollItems PayrollItem[]
  roleAssignments EmployeeRoleAssignment[]
  kpis EmployeeKpi[]
  sentHrNotifications HrNotification[] @relation("HrNotificationSender")
  receivedHrNotifications HrNotification[] @relation("HrNotificationReceiver")

  @@unique([businessId, employeeNo])
  @@index([businessId, branchId, deletedAt])
  @@index([businessId, departmentId, designationId, lifecycleStatus, deletedAt])
  @@map("employees")
}

model Department {
  id         String   @id @default(uuid())
  businessId String
  branchId   String?
  name       String
  code       String
  createdBy  String?
  updatedBy  String?
  deletedBy  String?
  deletedAt  DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch   Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  employees Employee[]
  designations Designation[]
  employeeRoleAssignments EmployeeRoleAssignment[]

  @@unique([businessId, code])
  @@unique([businessId, branchId, name])
  @@index([businessId, branchId, deletedAt])
  @@map("departments")
}

model Designation {
  id           String   @id @default(uuid())
  businessId   String
  branchId     String?
  departmentId String?
  name         String
  code         String
  createdBy    String?
  updatedBy    String?
  deletedBy    String?
  deletedAt    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  business   Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch     Branch?     @relation(fields: [branchId], references: [id], onDelete: SetNull)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  employees  Employee[]

  @@unique([businessId, code])
  @@unique([businessId, branchId, name])
  @@index([businessId, branchId, departmentId, deletedAt])
  @@map("designations")
}

model EmployeeEmergencyContact {
  id          String   @id @default(uuid())
  businessId  String
  employeeId  String
  name        String
  relationship String?
  phone       String
  email       String?
  address     String?
  isPrimary   Boolean  @default(false)
  createdBy   String?
  updatedBy   String?
  deletedBy   String?
  deletedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([businessId, employeeId, deletedAt])
  @@map("employee_emergency_contacts")
}

model EmployeeDocument {
  id          String         @id @default(uuid())
  businessId  String
  employeeId  String
  type        HrDocumentType
  title       String
  fileName    String
  mimeType    String
  extension   String?
  sizeBytes   Int
  storagePath String
  metadata    Json?
  createdBy   String?
  updatedBy   String?
  deletedBy   String?
  deletedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([businessId, employeeId, type, deletedAt])
  @@map("employee_documents")
}

model AttendanceShift {
  id           String   @id @default(uuid())
  businessId   String
  branchId     String?
  name         String
  code         String
  startTime    String
  endTime      String
  breakMinutes Int      @default(0)
  graceMinutes Int      @default(0)
  createdBy    String?
  updatedBy    String?
  deletedBy    String?
  deletedAt    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  business  Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch    Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  attendanceRecords AttendanceRecord[]

  @@unique([businessId, code])
  @@index([businessId, branchId, deletedAt])
  @@map("attendance_shifts")
}

model AttendanceRecord {
  id                String   @id @default(uuid())
  businessId        String
  branchId          String?
  employeeId        String
  shiftId           String?
  attendanceDate    DateTime
  clockInAt         DateTime?
  clockOutAt        DateTime?
  breakMinutes      Int      @default(0)
  workingMinutes    Int      @default(0)
  overtimeMinutes   Int      @default(0)
  lateByMinutes     Int      @default(0)
  earlyExitMinutes  Int      @default(0)
  geoMeta           Json?
  status            AttendanceStatus @default(PRESENT)
  correctionStatus  String?
  createdBy         String?
  updatedBy         String?
  deletedBy         String?
  deletedAt         DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  business  Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch    Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  employee  Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  shift     AttendanceShift? @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  breaks    AttendanceBreak[]
  corrections AttendanceCorrection[]

  @@unique([businessId, employeeId, attendanceDate])
  @@index([businessId, branchId, attendanceDate, deletedAt])
  @@index([businessId, employeeId, attendanceDate, deletedAt])
  @@map("attendance_records")
}

model AttendanceBreak {
  id                 String   @id @default(uuid())
  businessId         String
  branchId           String?
  employeeId         String
  attendanceRecordId String
  breakStartAt       DateTime
  breakEndAt         DateTime?
  durationMinutes    Int      @default(0)
  createdBy          String?
  updatedBy          String?
  deletedBy          String?
  deletedAt          DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch   Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  attendanceRecord AttendanceRecord @relation(fields: [attendanceRecordId], references: [id], onDelete: Cascade)

  @@index([businessId, employeeId, breakStartAt, deletedAt])
  @@index([businessId, attendanceRecordId, deletedAt])
  @@map("attendance_breaks")
}

model AttendanceCorrection {
  id                 String   @id @default(uuid())
  businessId         String
  branchId           String?
  employeeId         String
  attendanceRecordId String
  requestedById      String?
  approvedById       String?
  reason             String
  requestPayload     Json?
  status             String   @default("PENDING")
  reviewedAt         DateTime?
  createdBy          String?
  updatedBy          String?
  deletedBy          String?
  deletedAt          DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch   Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  attendanceRecord AttendanceRecord @relation(fields: [attendanceRecordId], references: [id], onDelete: Cascade)

  @@index([businessId, employeeId, status, createdAt])
  @@index([businessId, attendanceRecordId, deletedAt])
  @@map("attendance_corrections")
}

model LeaveType {
  id            String   @id @default(uuid())
  businessId    String
  name          String
  code          String
  maxDaysPerYear Float   @default(0)
  isPaid        Boolean  @default(true)
  createdBy     String?
  updatedBy     String?
  deletedBy     String?
  deletedAt     DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  leaveBalances LeaveBalance[]
  leaveRequests LeaveRequest[]

  @@unique([businessId, code])
  @@index([businessId, deletedAt])
  @@map("leave_types")
}

model LeaveBalance {
  id             String   @id @default(uuid())
  businessId     String
  branchId       String?
  employeeId     String
  leaveTypeId    String
  year           Int
  allocatedDays  Float    @default(0)
  usedDays       Float    @default(0)
  carryForwardDays Float  @default(0)
  createdBy      String?
  updatedBy      String?
  deletedBy      String?
  deletedAt      DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  business  Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch    Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  employee  Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)

  @@unique([businessId, employeeId, leaveTypeId, year])
  @@index([businessId, branchId, year, deletedAt])
  @@map("leave_balances")
}

model LeaveRequest {
  id            String   @id @default(uuid())
  businessId    String
  branchId      String?
  employeeId    String
  leaveTypeId   String
  fromDate      DateTime
  toDate        DateTime
  totalDays     Float
  reason        String?
  status        LeaveRequestStatus @default(PENDING)
  approvedById  String?
  reviewedAt    DateTime?
  rejectionReason String?
  createdBy     String?
  updatedBy     String?
  deletedBy     String?
  deletedAt     DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  business  Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch    Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  employee  Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)

  @@index([businessId, employeeId, status, createdAt])
  @@index([businessId, branchId, fromDate, toDate, deletedAt])
  @@map("leave_requests")
}

model HolidayCalendar {
  id          String   @id @default(uuid())
  businessId  String
  branchId    String?
  holidayDate DateTime
  name        String
  description String?
  createdBy   String?
  updatedBy   String?
  deletedBy   String?
  deletedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch   Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@unique([businessId, branchId, holidayDate, name])
  @@index([businessId, branchId, holidayDate, deletedAt])
  @@map("holiday_calendars")
}

model WeeklyOffConfiguration {
  id         String   @id @default(uuid())
  businessId String
  branchId   String?
  weekday    Int
  isActive   Boolean  @default(true)
  createdBy  String?
  updatedBy  String?
  deletedBy  String?
  deletedAt  DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
