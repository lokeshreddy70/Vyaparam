generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  OWNER
  MANAGER
  CASHIER
  KITCHEN_STAFF
  WAITER
}

enum BusinessType {
  RESTAURANT
  CAFE
  BAKERY
  GROCERY
  SUPERMARKET
  MEDICAL
  PHARMACY
  CEMENT
  HARDWARE
  PAINT
  ELECTRICAL
  PESTICIDE
  AGRICULTURE
  WHOLESALE
  RETAIL
}

enum OrderType {
  DINE_IN
  TAKEAWAY
  DELIVERY
}

enum KotStatus {
  QUEUED
  READY
  CANCELLED
}

enum OrderStatus {
  PENDING
  SENT_TO_KITCHEN
  READY
  BILLED
  CANCELLED
}

enum InvoiceStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  REFUNDED
}

enum PaymentMethod {
  CASH
  CARD
  UPI
  BANK_TRANSFER
  WALLET
  NET_BANKING
  GIFT_CARD
  STORE_CREDIT
  MIXED
}

enum BillingDocumentType {
  SALES_INVOICE
  PURCHASE_INVOICE
  QUOTATION
  ESTIMATE
  SALES_ORDER
  PURCHASE_ORDER
  DELIVERY_CHALLAN
  GOODS_RECEIPT_NOTE
  SALES_RETURN
  PURCHASE_RETURN
  CREDIT_NOTE
  DEBIT_NOTE
  EXPENSE_ENTRY
  INCOME_ENTRY
  POS_BILL
}

enum BillingDocumentStatus {
  DRAFT
  HOLD
  CONFIRMED
  COMPLETED
  CANCELLED
  VOID
}

enum ShiftStatus {
  OPEN
  CLOSED
}

enum TableStatus {
  AVAILABLE
  OCCUPIED
  CLEANING
}

enum MovementType {
  IN
  OUT
  ADJUSTMENT
  TRANSFER_IN
  TRANSFER_OUT
}

enum PurchaseOrderStatus {
  DRAFT
  OPEN
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum SalesOrderStatus {
  DRAFT
  CONFIRMED
  PARTIALLY_FULFILLED
  FULFILLED
  CANCELLED
}

enum TransferStatus {
  DRAFT
  IN_TRANSIT
  COMPLETED
  CANCELLED
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

enum NotificationType {
  INFO
  WARNING
  ERROR
  SUCCESS
}

enum LedgerEntryType {
  DEBIT
  CREDIT
  ADJUSTMENT
}

model Business {
  id          String   @id @default(uuid())
  name        String
  type        BusinessType
  address     String?
  phone       String?
  gstNumber   String?
  createdBy   String?
  updatedBy   String?
  deletedBy   String?
  deletedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  branches          Branch[]
  users             User[]
  employees         Employee[]
  roles             RoleEntity[]
  permissions       Permission[]
  rolePermissions   RolePermission[]
  customerGroups    CustomerGroup[]
  customerTypes     CustomerType[]
  customers         Customer[]
  customerContacts  CustomerContact[]
  customerAddresses CustomerAddress[]
  customerLedgers   CustomerLedger[]
  supplierGroups    SupplierGroup[]
  supplierTypes     SupplierType[]
  suppliers         Supplier[]
  supplierContacts  SupplierContact[]
  supplierAddresses SupplierAddress[]
  supplierLedgers   SupplierLedger[]
  categories        Category[]
  subCategories     SubCategory[]
  brands            Brand[]
  units             Unit[]
  products          Product[]
  productVariants   ProductVariant[]
  warehouses        Warehouse[]
  inventories       Inventory[]
  inventoryMovements InventoryMovement[]
  purchaseOrders    PurchaseOrder[]
  purchaseItems     PurchaseItem[]
  salesOrders       SalesOrder[]
  salesItems        SalesItem[]
  bills             Bill[]
  billItems         BillItem[]
  invoices          Invoice[]
  billingDocuments  BillingDocument[]
  billingDocumentItems BillingDocumentItem[]
  payments          Payment[]
  cashRegisters     CashRegister[]
  cashShifts        CashShift[]
  posTerminals      PosTerminal[]
  expenses          Expense[]
  expenseCategories ExpenseCategory[]
  taxes             Tax[]
  discounts         Discount[]
  coupons           Coupon[]
  priceLists        PriceList[]
  stockAdjustments  StockAdjustment[]
  transfers         Transfer[]
  tables            RestaurantTable[]
  kitchenOrders     KitchenOrder[]
  orders            Order[]
  notifications     Notification[]
  settings          Setting[]
  subscriptionPlans SubscriptionPlan[]
  subscriptions     Subscription[]
  featureFlags      FeatureFlag[]
  refreshTokens     RefreshToken[]
  sessions          Session[]
  auditLogs         AuditLog[]
  activityLogs      ActivityLog[]
  errorLogs         ErrorLog[]

  @@index([deletedAt])
  @@map("businesses")
}

model Branch {
  id        String   @id @default(uuid())
  businessId String
  name      String
  address   String?
  phone     String?
  createdBy String?
  updatedBy String?
  deletedBy String?
  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business           Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  users              User[]
  employees          Employee[]
  customers          Customer[]
  customerLedgers    CustomerLedger[]
  suppliers          Supplier[]
  supplierLedgers    SupplierLedger[]
  products           Product[]
  productVariants    ProductVariant[]
  warehouses         Warehouse[]
  inventories        Inventory[]
  inventoryMovements InventoryMovement[]
  purchaseOrders     PurchaseOrder[]
  salesOrders        SalesOrder[]
  bills              Bill[]
  invoices           Invoice[]
  billingDocuments   BillingDocument[]
  cashRegisters      CashRegister[]
  cashShifts         CashShift[]
  posTerminals       PosTerminal[]
  payments           Payment[]
  expenses           Expense[]
  priceLists         PriceList[]
  stockAdjustments   StockAdjustment[]
  transfersFrom      Transfer[] @relation("TransferFromBranch")
  transfersTo        Transfer[] @relation("TransferToBranch")
  tables             RestaurantTable[]
  orders             Order[]
  kitchenOrders      KitchenOrder[]
  notifications      Notification[]
  settings           Setting[]
  refreshTokens      RefreshToken[]
  sessions           Session[]
  auditLogs          AuditLog[]
  activityLogs       ActivityLog[]
  errorLogs          ErrorLog[]

  @@unique([businessId, name])
  @@index([businessId, deletedAt])
  @@map("branches")
}

model User {
  id               String   @id @default(uuid())
  businessId       String
  branchId         String?
  name             String
  email            String   @unique
  passwordHash     String
  role             Role     @default(OWNER)
  isActive         Boolean  @default(true)
  failedLoginAttempts Int   @default(0)
  lockedUntil      DateTime?
  refreshTokenHash String?
  createdBy        String?
  updatedBy        String?
  deletedBy        String?
  deletedAt        DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  business         Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch           Branch?   @relation(fields: [branchId], references: [id], onDelete: SetNull)
  employee         Employee?
  customerInvoices Invoice[] @relation("InvoiceCustomer")
  cashierInvoices  Invoice[] @relation("InvoiceCashier")
  refreshTokens    RefreshToken[]
  sessions         Session[]
  auditLogs        AuditLog[]
  activityLogs     ActivityLog[]
  errorLogs        ErrorLog[]

  @@index([businessId, branchId, deletedAt])
  @@map("users")
}

model Employee {
  id         String   @id @default(uuid())
  businessId String
  branchId   String?
  userId     String   @unique
  employeeNo String
  designation String?
  createdBy  String?
  updatedBy  String?
  deletedBy  String?
  deletedAt  DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch   Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([businessId, employeeNo])
  @@index([businessId, branchId, deletedAt])
  @@map("employees")
}

model RoleEntity {
  id          String   @id @default(uuid())
  businessId  String?
  name        String
  description String?
  createdBy   String?
  updatedBy   String?
  deletedBy   String?
  deletedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  business        Business?        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  rolePermissions RolePermission[]

  @@unique([businessId, name])
  @@index([businessId, deletedAt])
  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid())
  businessId  String?
  name        String
  description String?
  createdBy   String?
  updatedBy   String?
  deletedBy   String?
  deletedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  business        Business?        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  rolePermissions RolePermission[]

  @@unique([businessId, name])
  @@index([businessId, deletedAt])
  @@map("permissions")
}

model RolePermission {
  id           String   @id @default(uuid())
  businessId   String
  roleId       String
  permissionId String
  createdBy    String?
  updatedBy    String?
  deletedBy    String?
  deletedAt    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  business   Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  role       RoleEntity @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([businessId, deletedAt])
  @@map("role_permissions")
}

model CustomerGroup {
  id         String   @id @default(uuid())
  businessId String
  name       String
  createdBy  String?
  updatedBy  String?
  deletedBy  String?
  deletedAt  DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business  Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customers Customer[]

  @@unique([businessId, name])
  @@index([businessId, deletedAt])
  @@map("customer_groups")
}

model CustomerType {
  id         String   @id @default(uuid())
  businessId String
  name       String
  description String?
  createdBy  String?
  updatedBy  String?
  deletedBy  String?
  deletedAt  DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business  Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customers Customer[]

  @@unique([businessId, name])
  @@index([businessId, deletedAt])
  @@map("customer_types")
}

model Customer {
  id              String   @id @default(uuid())
  businessId      String
  branchId        String?
  customerGroupId String?
  customerTypeId  String?
  name            String
  phone           String?
  email           String?
  gstNumber       String?
  panNumber       String?
  tinNumber       String?
  creditLimit     Float    @default(0)
  outstandingBalance Float @default(0)
  notes           String?
  tags            Json?
  isActive        Boolean  @default(true)
  createdBy       String?
  updatedBy       String?
  deletedBy       String?
  deletedAt       DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  business      Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch        Branch?        @relation(fields: [branchId], references: [id], onDelete: SetNull)
  customerGroup CustomerGroup? @relation(fields: [customerGroupId], references: [id], onDelete: SetNull)
  customerType  CustomerType?  @relation(fields: [customerTypeId], references: [id], onDelete: SetNull)
  contacts      CustomerContact[]
  addresses     CustomerAddress[]
  ledgers       CustomerLedger[]
  billingDocuments BillingDocument[]
  bills         Bill[]
  salesOrders   SalesOrder[]

  @@unique([businessId, phone])
  @@index([businessId, email])
  @@index([businessId, name, deletedAt])
  @@index([businessId, branchId, deletedAt])
  @@map("customers")
}

model SupplierGroup {
  id         String   @id @default(uuid())
  businessId String
  name       String
  createdBy  String?
  updatedBy  String?
  deletedBy  String?
  deletedAt  DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business  Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  suppliers Supplier[]

  @@unique([businessId, name])
  @@index([businessId, deletedAt])
  @@map("supplier_groups")
}

model SupplierType {
  id         String   @id @default(uuid())
  businessId String
  name       String
  description String?
  createdBy  String?
  updatedBy  String?
  deletedBy  String?
  deletedAt  DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business  Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  suppliers Supplier[]

  @@unique([businessId, name])
  @@index([businessId, deletedAt])
  @@map("supplier_types")
}

model Supplier {
  id              String   @id @default(uuid())
  businessId      String
  branchId        String?
  supplierGroupId String?
  supplierTypeId  String?
  name            String
  phone           String?
  email           String?
  gstNumber       String?
  panNumber       String?
  tinNumber       String?
  creditLimit     Float    @default(0)
  outstandingBalance Float @default(0)
  notes           String?
  tags            Json?
  isActive        Boolean  @default(true)
  createdBy       String?
  updatedBy       String?
  deletedBy       String?
  deletedAt       DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  business      Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch        Branch?        @relation(fields: [branchId], references: [id], onDelete: SetNull)
  supplierGroup SupplierGroup? @relation(fields: [supplierGroupId], references: [id], onDelete: SetNull)
  supplierType  SupplierType?  @relation(fields: [supplierTypeId], references: [id], onDelete: SetNull)
  contacts      SupplierContact[]
  addresses     SupplierAddress[]
  ledgers       SupplierLedger[]
  billingDocuments BillingDocument[]
  purchaseOrders PurchaseOrder[]

  @@unique([businessId, phone])
  @@index([businessId, email])
  @@index([businessId, name, deletedAt])
  @@index([businessId, branchId, deletedAt])
  @@map("suppliers")
}

model CustomerContact {
  id         String   @id @default(uuid())
  businessId String
  customerId String
  name       String
  designation String?
  phone      String?
  email      String?
  isPrimary  Boolean  @default(false)
  createdBy  String?
  updatedBy  String?
  deletedBy  String?
  deletedAt  DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([businessId, customerId, deletedAt])
  @@map("customer_contacts")
}

model SupplierContact {
  id         String   @id @default(uuid())
  businessId String
  supplierId String
  name       String
  designation String?
  phone      String?
  email      String?
  isPrimary  Boolean  @default(false)
  createdBy  String?
  updatedBy  String?
  deletedBy  String?
  deletedAt  DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([businessId, supplierId, deletedAt])
  @@map("supplier_contacts")
}

model CustomerAddress {
  id         String   @id @default(uuid())
  businessId String
  customerId String
  label      String?
  address1   String
  address2   String?
  city       String?
  state      String?
  country    String?
  postalCode String?
  isPrimary  Boolean  @default(false)
  createdBy  String?
  updatedBy  String?
  deletedBy  String?
  deletedAt  DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([businessId, customerId, deletedAt])
  @@map("customer_addresses")
}

model SupplierAddress {
  id         String   @id @default(uuid())
  businessId String
  supplierId String
  label      String?
  address1   String
  address2   String?
  city       String?
  state      String?
  country    String?
  postalCode String?
  isPrimary  Boolean  @default(false)
  createdBy  String?
  updatedBy  String?
  deletedBy  String?
  deletedAt  DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([businessId, supplierId, deletedAt])
  @@map("supplier_addresses")
}

model CustomerLedger {
  id            String          @id @default(uuid())
  businessId    String
  branchId      String?
  customerId    String
  entryType     LedgerEntryType
  amount        Float
  balanceAfter  Float
  referenceType String?
  referenceId   String?
  remarks       String?
  metadata      Json?
  createdBy     String?
  updatedBy     String?
  deletedBy     String?
  deletedAt     DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch   Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([businessId, customerId, createdAt])
  @@index([businessId, branchId, createdAt])
  @@map("customer_ledgers")
}

model SupplierLedger {
  id            String          @id @default(uuid())
  businessId    String
  branchId      String?
  supplierId    String
  entryType     LedgerEntryType
  amount        Float
  balanceAfter  Float
  referenceType String?
  referenceId   String?
  remarks       String?
  metadata      Json?
  createdBy     String?
  updatedBy     String?
  deletedBy     String?
  deletedAt     DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch   Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([businessId, supplierId, createdAt])
  @@index([businessId, branchId, createdAt])
  @@map("supplier_ledgers")
}

model Category {
  id         String   @id @default(uuid())
  businessId String
  name       String
  createdBy  String?
  updatedBy  String?
  deletedBy  String?
  deletedAt  DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business      Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  products      Product[]
  subCategories SubCategory[]

  @@unique([businessId, name])
  @@index([businessId, deletedAt])
  @@map("categories")
}

model SubCategory {
  id         String   @id @default(uuid())
  businessId String
  categoryId String
  name       String
  createdBy  String?
  updatedBy  String?
  deletedBy  String?
  deletedAt  DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([categoryId, name])
  @@index([businessId, deletedAt])
  @@map("sub_categories")
}

model Brand {
  id         String   @id @default(uuid())
  businessId String
  name       String
  createdBy  String?
  updatedBy  String?
  deletedBy  String?
  deletedAt  DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([businessId, name])
  @@index([businessId, deletedAt])
  @@map("brands")
}

model Unit {
  id         String   @id @default(uuid())
  businessId String
  name       String
  symbol     String
  createdBy  String?
  updatedBy  String?
  deletedBy  String?
  deletedAt  DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([businessId, symbol])
  @@index([businessId, deletedAt])
  @@map("units")
}

model Product {
  id            String   @id @default(uuid())
  businessId    String
  branchId      String?
  categoryId    String?
  subCategoryId String?
  brandId       String?
  unitId        String?
  name          String
  description   String?
  sku           String?
  barcode       String?
  price         Float
  taxPercent    Float?   @default(0)
  trackStock    Boolean  @default(false)
  stockQty      Int?     @default(0)
  isAvailable   Boolean  @default(true)
  imageUrl      String?
  createdBy     String?
  updatedBy     String?
  deletedBy     String?
  deletedAt     DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  business        Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch          Branch?          @relation(fields: [branchId], references: [id], onDelete: SetNull)
  category        Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  subCategory     SubCategory?     @relation(fields: [subCategoryId], references: [id], onDelete: SetNull)
  brand           Brand?           @relation(fields: [brandId], references: [id], onDelete: SetNull)
  unit            Unit?            @relation(fields: [unitId], references: [id], onDelete: SetNull)
  orderItems      OrderItem[]
  purchaseItems   PurchaseItem[]
  salesItems      SalesItem[]
  billItems       BillItem[]
  billingDocumentItems BillingDocumentItem[]
  variants        ProductVariant[]
  inventories     Inventory[]

  @@unique([businessId, sku])
  @@index([businessId, branchId, categoryId, deletedAt])
  @@map("products")
}

model ProductVariant {
  id          String   @id @default(uuid())
  businessId  String
  branchId    String?
  productId   String
  sku         String?
  barcode     String?
  name        String
  price       Float
  createdBy   String?
  updatedBy   String?
  deletedBy   String?
  deletedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  business  Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch    Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, name])
  @@index([businessId, branchId, deletedAt])
  @@map("product_variants")
}

model Warehouse {
  id         String   @id @default(uuid())
  businessId String
  branchId   String?
  name       String
  code       String
  createdBy  String?
  updatedBy  String?
  deletedBy  String?
  deletedAt  DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business         Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch           Branch?              @relation(fields: [branchId], references: [id], onDelete: SetNull)
  inventories      Inventory[]
  transfersFrom    Transfer[]           @relation("TransferFromWarehouse")
  transfersTo      Transfer[]           @relation("TransferToWarehouse")
  stockAdjustments StockAdjustment[]

  @@unique([businessId, code])
  @@index([businessId, branchId, deletedAt])
  @@map("warehouses")
}

model Inventory {
  id           String   @id @default(uuid())
  businessId   String
  branchId     String?
  warehouseId  String
  productId    String
  quantity     Float    @default(0)
  reorderLevel Float?   @default(0)
  createdBy    String?
  updatedBy    String?
  deletedBy    String?
  deletedAt    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  business           Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch             Branch?              @relation(fields: [branchId], references: [id], onDelete: SetNull)
  warehouse          Warehouse            @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  product            Product              @relation(fields: [productId], references: [id], onDelete: Restrict)
  inventoryMovements InventoryMovement[]

  @@unique([warehouseId, productId])
  @@index([businessId, branchId, deletedAt])
